{
  "name": "@provoly/dashboard",
  "version": "0.0.0",
  "type": "commonjs",
  "scripts": {
    "build": "tsc --module commonjs -p tsconfig.schematics.json",
    "postbuild": "copyfiles schematics/*/schema.json schematics/*/files/** schematics/collection.json schematics/migration.json ../../../dist/@provoly/dashboard/"
  },
  "peerDependencies": {
    "@angular/common": "15.x || 16.x",
    "@angular/cdk": "14.x || 15.x || 16.x",
    "@angular/core": "15.x || 16.x",
    "@angular/router": "15.x || 16.x",
    "@angular/platform-browser": "15.x || 16.x",
    "@ngrx/effects": "16.x",
    "@ngrx/entity": "16.x",
    "@ngrx/store": "16.x",
    "@ng-select/ng-select": "9.x || 10.x || 11.x",
    "uuid": "^8.3.2 || ^9.0.0",
    "fast-deep-equal": "3.1.3",
    "buffer": "^6.0.0",
    "css-element-queries": "^1.2.3",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "litegraph.js": "^0.7.10",
    "ol": "^7.0.0",
    "ol-mapbox-style": "^10.6.0",
    "proj4": "^2.9.0",
    "rxjs": "^7.4.0",
    "vega": "^5.21.0",
    "vega-embed": "^6.20.5",
    "vega-lite": "^5.2.0",
    "zone.js": "~0.13.0"
  },
  "peerDependenciesMeta": {
    "d3-drag": {
      "optional": true
    },
    "d3-force": {
      "optional": true
    },
    "d3-selection": {
      "optional": true
    },
    "litegraph.js": {
      "optional": true
    },
    "ol": {
      "optional": true
    },
    "ol-mapbox-style": {
      "optional": true
    },
    "proj4": {
      "optional": true
    },
    "vega": {
      "optional": true
    },
    "vega-embed": {
      "optional": true
    }
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@types/d3-dispatch": "^3.0.1",
    "@types/d3-drag": "^3.0.1",
    "@types/d3-force": "^3.0.3",
    "@types/d3-timer": "^3.0.0",
    "@types/dagre": "^0.7.47",
    "@types/ol": "^6.5.3",
    "@types/uuid": "^9.0.0",
    "copyfiles": "^2.4.1",
    "typescript": "~4.9.4"
  },
  "exports": {
    "./lib/theme/styles/themes": {
      "sass": "./lib/theme/styles/_themes.scss"
    },
    "./styles/main": {
      "sass": "./styles/main.scss"
    },
    "./styles-theme/main": {
      "sass": "./styles-theme/main-theme.scss"
    }
  },
  "schematics": "./schematics/collection.json",
  "ng-add": {
    "save": true
  },
  "ng-update": {
    "migrations": "./schematics/migration.json",
    "save": true
  }
}
