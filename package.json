{
  "name": "provoly-dashboard",
  "version": "0.0.0",
  "homepage": "",
  "repository": {
    "type": "git",
    "url": ""
  },
  "keywords": [
    "pry",
    "widget",
    "dashboard",
    "map",
    "graph"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "author": "onepoint <contact@groupeonepoint.com> (https://www.groupeonepoint.com/fr/)",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --configuration development",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "NODE_OPTIONS=--experimental-vm-modules; npx jest --coverage --roots \"src\"",
    "build:lib": "ng build @provoly/dashboard --configuration development",
    "build:lib:prod": "ng build @provoly/dashboard",
    "watch:lib": "ng build @provoly/dashboard --configuration development --watch",
    "test:lib": "NODE_OPTIONS=--experimental-vm-modules; npx jest --coverage --roots projects/provoly/dashboard -w 4",
    "test:lib:ci": "NODE_OPTIONS=--experimental-vm-modules; npx jest --coverage --roots projects/provoly/dashboard -w 2 --ci --forceExit",
    "config:test:lib": "NODE_OPTIONS=--experimental-vm-modules; npx jest --coverage --roots --showConfig projects/provoly/dashboard",
    "test:win:lib": "cross-env NODE_OPTIONS=--experimental-vm-modules && npx jest --coverage --roots projects/provoly/dashboard",
    "test:watch:lib": "NODE_OPTIONS=--experimental-vm-modules; npx jest --roots projects/provoly/dashboard --watch",
    "test:win:watch:lib": "cross-env NODE_OPTIONS=--experimental-vm-modules && npx jest --roots projects/provoly/dashboard --watch",
    "lint": "eslint --ext .js,.ts,.html ./src ./projects",
    "lint-fix": "eslint --fix --ext .js,.ts,.html ./src ./projects",
    "lint-prettier": "npx prettier ./src ./projects --write",
    "lint-prettier-ci": "npx prettier ./src ./projects --check",
    "version:from-tag": "npm version ${CI_COMMIT_TAG} --no-git-tag-version --no-commit-hooks --allow-same-version -w projects/provoly/dashboard",
    "pub": "cd dist/@provoly/dashboard; npm publish --access=public; cd ../..",
    "bundle:size": "ng build --stats-json; npx webpack-bundle-analyzer dist/*/stats.json",
    "prepare": "husky install",
    "docs": "compodoc -p ./tsconfig.docs.json -d ./compodoc"
  },
  "dependencies": {
    "@angular/animations": "^16.0.0",
    "@angular/cdk": "^16.0.2",
    "@angular/common": "^16.0.0",
    "@angular/compiler": "^16.0.0",
    "@angular/core": "^16.0.0",
    "@angular/forms": "^16.0.0",
    "@angular/platform-browser": "^16.0.0",
    "@angular/platform-browser-dynamic": "^16.0.0",
    "@angular/router": "^16.0.0",
    "@ng-select/ng-select": "^11.0.0",
    "@ngrx/effects": "^16.0.0",
    "@ngrx/entity": "^16.0.0",
    "@ngrx/store": "^16.0.0",
    "@ngrx/store-devtools": "^16.0.0",
    "buffer": "^6.0.0",
    "css-element-queries": "^1.2.3",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "fast-deep-equal": "3.1.3",
    "geojson-to-kml": "^0.0.1",
    "jszip": "^3.7.1",
    "litegraph.js": "^0.7.10",
    "ol": "^7.0.0",
    "ol-layerswitcher": "^4.1.0",
    "ol-mapbox-style": "^10.6.0",
    "proj4": "^2.9.0",
    "rxjs": "^7.4.0",
    "shpjs": "^4.0.2",
    "tslib": "^2.3.0",
    "uuid": "^9.0.0",
    "vega": "^5.21.0",
    "vega-embed": "^6.20.5",
    "vega-lite": "^5.2.0",
    "zone.js": "~0.13.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^16.0.3",
    "@angular-eslint/eslint-plugin": "^16.0.3",
    "@angular-eslint/eslint-plugin-template": "^16.0.3",
    "@angular-eslint/template-parser": "^16.0.3",
    "@angular/cli": "^16.0.0",
    "@angular/compiler-cli": "^16.0.0",
    "@babel/core": "^7.17.9",
    "@compodoc/compodoc": "^1.1.21",
    "@ngrx/schematics": "^16.0.0",
    "@peculiar/webcrypto": "^1.4.0",
    "@types/d3-dispatch": "^3.0.1",
    "@types/d3-drag": "^3.0.1",
    "@types/d3-force": "^3.0.3",
    "@types/d3-timer": "^3.0.0",
    "@types/dagre": "^0.7.47",
    "@types/jest": "^29.0.0",
    "@types/node": "^18.16.3",
    "@types/ol": "^6.5.3",
    "@types/proj4": "^2.5.2",
    "@types/shpjs": "^3.4.1",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^5.9.0",
    "@typescript-eslint/parser": "^5.7.0",
    "babel-loader": "^9.0.0",
    "canvas": "^2.11.2",
    "cross-env": "^7.0.3",
    "crypto": "^1.0.1",
    "eslint": "^8.6.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-angular": "^4.1.0",
    "eslint-plugin-prettier": "^4.1.0",
    "husky": "^8.0.0",
    "jest": "^29.0.0",
    "jest-marbles": "^3.0.2",
    "jest-preset-angular": "^13.1.1",
    "lint-staged": "^13.0.0",
    "ng-packagr": "^16.0.1",
    "node-sass": "^9.0.0",
    "prettier": "2.8.8",
    "typescript": "~4.9.4",
    "webpack-bundle-analyzer": "^4.5.0"
  },
  "exports": {
    ".": {
      "sass": "./lib/ds/_index.scss"
    }
  },
  "workspaces": [
    "projects/provoly/dashboard"
  ]
}
