{
  "name": "provoly-dashboard",
  "version": "0.0.0",
  "homepage": "",
  "repository": {
    "type": "git",
    "url": ""
  },
  "keywords": [
    "pry",
    "widget",
    "dashboard",
    "map",
    "graph"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "author": "onepoint <contact@groupeonepoint.com> (https://www.groupeonepoint.com/fr/)",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --configuration development",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "NODE_OPTIONS=--experimental-vm-modules; npx jest --coverage --roots \"src\"",
    "build:lib": "ng build @provoly/dashboard --configuration development",
    "build:lib:prod": "ng build @provoly/dashboard",
    "watch:lib": "ng build @provoly/dashboard --configuration development --watch",
    "test:lib": "NODE_OPTIONS=--experimental-vm-modules; npx jest --coverage --roots projects/provoly/dashboard -w 4",
    "test:lib:ci": "NODE_OPTIONS=--experimental-vm-modules; npx jest --roots projects/provoly/dashboard -w 4 --ci --forceExit",
    "test:lib:coverage:ci": "NODE_OPTIONS=--experimental-vm-modules; npx jest --coverage --roots projects/provoly/dashboard -w 4 --ci --forceExit",
    "config:test:lib": "NODE_OPTIONS=--experimental-vm-modules; npx jest --coverage --roots --showConfig projects/provoly/dashboard",
    "test:win:lib": "cross-env NODE_OPTIONS=--experimental-vm-modules && npx jest --coverage --roots projects/provoly/dashboard",
    "test:watch:lib": "NODE_OPTIONS=--experimental-vm-modules; npx jest --roots projects/provoly/dashboard --watch",
    "test:win:watch:lib": "cross-env NODE_OPTIONS=--experimental-vm-modules && npx jest --roots projects/provoly/dashboard --watch",
    "lint": "eslint --ext .js,.ts,.html ./src ./projects",
    "lint-fix": "eslint --fix --ext .js,.ts,.html ./src ./projects",
    "lint-prettier": "npx prettier ./src ./projects --write",
    "lint-prettier-ci": "npx prettier ./src ./projects --check",
    "pub": "cd dist/@provoly/dashboard; npm publish --access=public; cd ../..",
    "bundle:size": "ng build --stats-json; npx webpack-bundle-analyzer dist/*/stats.json",
    "docs": "compodoc -p ./tsconfig.docs.json -d ./compodoc --silent",
    "cve": "npm audit --json > ./npm_audit_report.json"
  },
  "dependencies": {
    "@angular/animations": "^18.2.6",
    "@angular/cdk": "^18.2.6",
    "@angular/common": "^18.2.6",
    "@angular/compiler": "^18.2.6",
    "@angular/core": "^18.2.6",
    "@angular/forms": "^18.2.6",
    "@angular/platform-browser": "^18.2.6",
    "@angular/platform-browser-dynamic": "^18.2.6",
    "@angular/router": "^18.2.6",
    "@ngrx/effects": "^18.0.2",
    "@ngrx/entity": "^18.0.2",
    "@ngrx/store": "^18.0.2",
    "@ngrx/store-devtools": "^18.0.2",
    "@schematics/angular": "^18.2.6",
    "buffer": "^6.0.0",
    "css-element-queries": "^1.2.3",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "fast-deep-equal": "3.1.3",
    "litegraph.js": "^0.7.10",
    "marked": "^13.0.0",
    "ol": "^7.0.0",
    "proj4": "^2.9.0",
    "rxjs": "^7.4.0",
    "tslib": "^2.6.2",
    "uuid": "^9.0.0",
    "vega": "^5.21.0",
    "vega-embed": "^6.23.0",
    "vega-lite": "^5.2.0",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.6",
    "@angular-eslint/eslint-plugin": "^18.3.1",
    "@angular-eslint/eslint-plugin-template": "^18.3.1",
    "@angular-eslint/template-parser": "^18.3.1",
    "@angular/cli": "^18.2.6",
    "@angular/compiler-cli": "^18.2.6",
    "@babel/core": "^7.17.9",
    "@compodoc/compodoc": "^1.1.21",
    "@peculiar/webcrypto": "^1.4.0",
    "@types/d3-dispatch": "^3.0.1",
    "@types/d3-drag": "^3.0.1",
    "@types/d3-force": "^3.0.3",
    "@types/d3-timer": "^3.0.0",
    "@types/dagre": "^0.7.47",
    "@types/jest": "^29.5.13",
    "@types/node": "^18.18.6",
    "@types/ol": "^6.5.3",
    "@types/proj4": "^2.5.2",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "babel-loader": "^9.0.0",
    "canvas": "^2.11.2",
    "cross-env": "^7.0.3",
    "crypto": "^1.0.1",
    "eslint": "^8.6.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-angular": "^4.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "jest-marbles": "^3.0.6",
    "jest-preset-angular": "^14.2.4",
    "lint-staged": "^13.0.0",
    "ng-packagr": "^18.2.1",
    "node-sass": "npm:sass@^1.79.4",
    "prettier": "3.2.5",
    "typescript": "~5.5.4",
    "webpack-bundle-analyzer": "^4.5.0"
  },
  "exports": {
    ".": {
      "sass": "./lib/ds/_index.scss"
    },
    "./package.json": "./package.json"
  },
  "workspaces": [
    "projects/provoly/dashboard"
  ]
}
