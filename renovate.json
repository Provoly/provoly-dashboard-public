{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "baseBranches": ["main"],
  "rebaseWhen": "never",
  "extends": [
    "config:recommended",
    "schedule:weekly",
    ":maintainLockFilesWeekly",
    ":semanticCommitTypeAll(chore)"
  ],
  "addLabels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "matchPackagePatterns": ["^@angular", "@schematics", "@ngrx"],
      "groupName": "angular packages",
      "enabled": true
    },
    {
      "matchPackagePatterns": ["^jest", "@types/jest"],
      "groupName": "jest packages",
      "enabled": true
    },
    {
      "paths": ["mock-server/package.json"],
      "groupName": "mock server packages",
      "branchPrefix": "renovate/mock-server/"
    },
    {
      "groupName": "GithubActions",
      "description": "Github actions are grouped, and skip 'Required approvals' rule",
      "matchDepTypes": [
        "action"
      ],
      "automerge": true
    },
    {
      "groupName": "AllPatchUpdates",
      "description": "All patch and digest updates are grouped, and skip 'Required approvals' rule",
      "matchUpdateTypes": [
        "patch",
        "digest"
      ],
      "automerge": true
    }
  ]
}
